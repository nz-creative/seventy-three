{
  "name": "seventy-three",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate:type-scale": "node scripts/generate-type-scale.mjs",
    "storybook": "pnpm --filter @seventythree/storybook storybook",
    "build-storybook": "pnpm --filter @seventythree/storybook build-storybook"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@storybook/addon-a11y": "8.6.18",
      "@storybook/addon-essentials": "8.6.18",
      "@storybook/react": "8.6.18",
      "@storybook/react-vite": "8.6.18",
      "@storybook/test": "8.6.18",
      "storybook": "8.6.18"
    }
  }
}
