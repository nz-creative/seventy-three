{
  "name": "@seventythree/tokens",
  "version": "0.1.0",
  "description": "CSS design tokens: primitives, optional webfonts.css (Google CDN), seventythree semantic theme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nz-creative/seventy-three.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./themes/seventythree.css": "./dist/themes/seventythree.css",
    "./themes/primitives.css": "./dist/themes/primitives.css",
    "./themes/webfonts.css": "./dist/themes/webfonts.css"
  },
  "scripts": {
    "build": "mkdir -p dist/themes && cp src/themes/*.css dist/themes/"
  }
}
